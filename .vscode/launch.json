    "version": "0.2.0",
    "configurations": [
        {
            "name": "app",
            "cwd": "app",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "app (profile mode)",
            "cwd": "app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
            "--dart-define=API_BASE_URL=http://192.168.10.39:8808/api"
        ]
        },
        {
            "name": "app (release mode)",
            "cwd": "app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
            "--dart-define=API_BASE_URL=http://192.168.10.39:8808/api"
        ]
        }
    ]
}